# Clerk keys: get your own dev instance keys from the Clerk dashboard (or ask a
# teammate). Never commit real keys to this file.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/en/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/en/portal/sign-up

# Database (Local Docker Postgres URL default)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/gtec_thodupuzha_dev?schema=public"

# Resend Email (Optional for local UI dev)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
CENTRE_STAFF_NOTIFICATION_EMAILS=staff@example.com

# Google Maps (Optional for local UI dev)
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=

# Cloudflare R2 Storage (Optional for local UI dev)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Inngest Background Jobs (Optional for local UI dev)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Upstash Redis Rate Limiting (Optional for local UI dev)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sentry Error Monitoring (Optional for local UI dev)
SENTRY_DSN=

# Contact info defaults
NEXT_PUBLIC_GTEC_WHATSAPP_NUMBER=+919876543210
NEXT_PUBLIC_GTEC_PHONE_NUMBER=+914862200000
GTEC_WHATSAPP_NUMBER=+919876543210
GTEC_PHONE_NUMBER=+914862200000

# Public site origin (used for sitemap.xml URLs)
NEXT_PUBLIC_SITE_URL=https://gtec-thodupuzha.com
