generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  JOB_SEEKER
  EMPLOYER
  CENTRE_STAFF
  SUPER_ADMIN
}

enum IndustrySector {
  IT_SOFTWARE
  EDUCATION_TRAINING
  HEALTHCARE
  BANKING_FINANCE
  MANUFACTURING
  RETAIL
  HOSPITALITY
  CONSTRUCTION
  TELECOMMUNICATION
  OTHER
}

enum EmployeeCountRange {
  RANGE_1_10
  RANGE_11_50
  RANGE_51_200
  RANGE_200_PLUS
}

enum EmployerProfileStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SalaryVisibility {
  DISCLOSE
  PRIVATE
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
}

enum JobPostingStatus {
  PENDING
  APPROVED
  REJECTED
  CLOSED
}

model User {
  id                String    @id
  role              Role
  languagePreference String    @default("en")
  deactivatedAt     DateTime?
  createdAt         DateTime  @default(now())

  candidateProfile CandidateProfile?
  employerProfile  EmployerProfile?
  auditLogEntries  AuditLogEntry[]
  staffPermission  StaffPermission?
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model CourseCategory {
  id        String   @id @default(cuid())
  nameEn    String
  nameMl    String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courses   Course[]

  @@index([sortOrder])
}

model Course {
  id              String       @id @default(cuid())
  slug            String       @unique
  titleEn         String
  titleMl         String?
  categoryId      String?
  descriptionEn   String?
  descriptionMl   String?
  durationText    String?
  syllabus        Json?
  certifications  String[]
  careerOutcomesEn String?
  careerOutcomesMl String?
  coverImageUrl   String?
  contentBlocks   Json?
  featured        Boolean      @default(false)
  status          CourseStatus @default(DRAFT)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  category        CourseCategory? @relation(fields: [categoryId], references: [id])
  enquiries       Enquiry[]
  enrollments     StudentCourseEnrollment[]
  academicResources AcademicResource[]
  progressEntries   StudentProgressEntry[]
  timetableEntries  TimetableEntry[]

  @@index([categoryId])
  @@index([status])
  @@index([featured])
}

enum EducationalQualification {
  SSLC
  PLUS_TWO
  DIPLOMA
  GRADUATE
  POST_GRADUATE
  OTHER
}

enum SkillStatus {
  PENDING
  APPROVED
}

enum PreferredJobType {
  FULL_TIME
  PART_TIME
  INTERNSHIP
  WORK_FROM_HOME
}

enum ResourceType {
  NOTE
  ASSIGNMENT
  PAST_PAPER
  LECTURE
  TIMETABLE
  PROGRESS
}

model Skill {
  id        String      @id @default(cuid())
  label     String      @unique
  status    SkillStatus @default(PENDING)
  createdAt DateTime    @default(now())
}

model CandidateProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  isVerifiedStudent Boolean  @default(false)
  studentRecordId  String?

  fullName                 String?
  dateOfBirth              DateTime?
  phone                    String?
  email                    String?
  courseCompletedIds       String[]
  certificationIds         String[]
  educationalQualification EducationalQualification?
  yearOfPassing            Int?
  address                  String?
  languagesKnown           String[]
  skillIds                 String[] @default([])
  preferredJobLocation     String?
  preferredJobType         PreferredJobType?
  careerObjective          String?
  photoUrl                 String?
  profileVisible           Boolean  @default(true)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  enrollments     StudentCourseEnrollment[]
  progressEntries StudentProgressEntry[]
  applications    Application[]
}

model EmployerProfile {
  id                String                @id @default(cuid())
  userId            String                @unique
  companyName       String
  industrySector    IndustrySector
  contactPersonName String
  designation       String
  phone             String
  email             String
  companyAddress    String
  hasWebsite        Boolean               @default(false)
  websiteUrl        String?
  employeeCountRange EmployeeCountRange
  aboutCompany      String
  status            EmployerProfileStatus @default(PENDING)
  autoPublishTrusted Boolean              @default(false)
  rejectionReason   String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  user User @relation(fields: [userId], references: [id])

  jobPostings JobPosting[]

  @@index([status])
}

enum ApplicationStatus {
  APPLIED
  VIEWED
  SHORTLISTED
  REJECTED
  HIRED
}

model Application {
  id                 String             @id @default(cuid())
  jobPostingId       String
  candidateProfileId String
  status             ApplicationStatus  @default(APPLIED)
  appliedAt          DateTime           @default(now())
  statusUpdatedAt    DateTime           @updatedAt
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  jobPosting        JobPosting        @relation(fields: [jobPostingId], references: [id])
  candidateProfile  CandidateProfile  @relation(fields: [candidateProfileId], references: [id])

  @@unique([jobPostingId, candidateProfileId])
  @@index([jobPostingId])
  @@index([candidateProfileId])
  @@index([status])
}

model JobPosting {
  id                  String            @id @default(cuid())
  employerId          String
  title               String
  department          String?
  salaryMin           Int?
  salaryMax           Int?
  salaryVisibility    SalaryVisibility  @default(PRIVATE)
  jobType             JobType
  skillIds            String[]          @default([])
  applicationDeadline DateTime
  description         String
  status              JobPostingStatus  @default(PENDING)
  rejectionReason     String?
  autoPublished       Boolean           @default(false)
  deletedAt           DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  employer     EmployerProfile @relation(fields: [employerId], references: [id])
  applications Application[]

  @@index([employerId])
  @@index([status])
  @@index([createdAt])
}

model FlashNewsItem {
  id        String   @id @default(cuid())
  textEn    String
  textMl    String?
  link      String?
  active    Boolean  @default(true)
  expiresAt DateTime?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, expiresAt])
  @@index([sortOrder])
}

model Enquiry {
  id        String   @id @default(cuid())
  name      String
  phone     String
  courseId  String?
  message   String?
  source    String
  createdAt DateTime @default(now())

  course Course? @relation(fields: [courseId], references: [id])

  @@index([courseId])
  @@index([createdAt])
}

enum WhyCardIcon {
  AWARD
  USERS
  BOOK_OPEN
  BRIEFCASE
  GLOBE
  HEADPHONES
}

model SiteSettings {
  id                   String   @id @default(cuid())
  yearsInOperation     String   @default("25+")
  studentsTrained     String   @default("3.2M+")
  centresWorldwide     String   @default("800+")
  affiliations         String   @default("100+")
  countries            String   @default("23")
  aboutBodyEn          String   @default("")
  aboutBodyMl          String?
  aboutPhotoUrl        String?
  address              String?
  mapEmbedUrl          String?
  mapsUrl              String?
  whatsappNumber       String?
  facebookUrl          String?
  instagramUrl         String?
  youtubeUrl           String?
  linkedinUrl          String?
  googleReviewsUrl     String?
  whyChooseUsCards     WhyChooseUsCard[]
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

enum NewsEventType {
  NEWS
  EVENT
}

model NewsEvent {
  id            String         @id @default(cuid())
  type          NewsEventType
  titleEn       String
  titleMl       String?
  bodyEn        String
  bodyMl        String?
  coverImageUrl String?
  eventDate     DateTime?
  publishedAt   DateTime?
  slug          String         @unique
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([type])
  @@index([publishedAt])
  @@index([eventDate])
}

enum GalleryMediaType {
  IMAGE
  VIDEO
}

model GalleryCategory {
  id        String   @id @default(cuid())
  slug      String   @unique
  nameEn    String
  nameMl    String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items GalleryItem[]

  @@index([sortOrder])
}

model GalleryItem {
  id        String           @id @default(cuid())
  categoryId String
  mediaType   GalleryMediaType
  url         String
  captionEn   String?
  captionMl   String?
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())

  category GalleryCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@index([sortOrder])
}

model CertificationPartner {
  id        String   @id @default(cuid())
  name      String
  nameMl    String?
  logoUrl   String
  link      String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([sortOrder])
}

model StudentRecord {
  id           String    @id @default(cuid())
  studentId    String    @unique
  fullName     String
  phone        String
  email        String?
  linkedUserId String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model WhyChooseUsCard {
  id             String       @id @default(cuid())
  siteSettingsId String
  sortOrder      Int          @default(0)
  icon           WhyCardIcon
  titleEn        String
  titleMl        String?
  descriptionEn  String
  descriptionMl  String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  siteSettings SiteSettings @relation(fields: [siteSettingsId], references: [id], onDelete: Cascade)

  @@index([siteSettingsId])
  @@index([sortOrder])
}

model StudentCourseEnrollment {
  id                String   @id @default(cuid())
  studentProfileId  String
  courseId          String
  enrolledAt        DateTime @default(now())
  createdAt         DateTime @default(now())

  candidateProfile CandidateProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  course           Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentProfileId, courseId])
  @@index([studentProfileId])
  @@index([courseId])
}

model AcademicResource {
  id         String       @id @default(cuid())
  courseId   String
  type       ResourceType
  title      String
  fileUrl    String?
  embedUrl   String?
  uploadedAt DateTime     @default(now())
  createdAt  DateTime     @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([type])
}

model StudentProgressEntry {
  id               String   @id @default(cuid())
  studentProfileId String
  courseId         String
  noteEn           String
  recordedAt       DateTime @default(now())
  createdAt        DateTime @default(now())

  studentProfile CandidateProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  course         Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([studentProfileId])
  @@index([courseId])
}

model TimetableEntry {
  id         String   @id @default(cuid())
  courseId   String
  contentText String
  createdAt  DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
}

model StaffPermission {
  id                           String  @id @default(cuid())
  userId                       String  @unique
  canEditCourses               Boolean @default(true)
  canEditGallery               Boolean @default(true)
  canEditCertificationPartners Boolean @default(true)
  canEditNewsEvents            Boolean @default(true)
  canEditFlashNews             Boolean @default(true)
  canProvisionStudents         Boolean @default(true)
  canApproveEmployers          Boolean @default(false)
  canApproveJobPostings        Boolean @default(false)
  canModerateSkillsTaxonomy    Boolean @default(true)

  user User @relation(fields: [userId], references: [id])
}

model AuditLogEntry {
  id           String   @id @default(cuid())
  actorUserId  String?
  actorRole    Role?
  action       String
  entityType   String
  entityId     String
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  actor User? @relation(fields: [actorUserId], references: [id])

  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

