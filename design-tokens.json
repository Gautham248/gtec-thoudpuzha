{
  "$schema": "https://design-tokens.org/schema.json",
  "meta": {
    "name": "GTEC Thodupuzha",
    "description": "Three-layer design tokens for GTEC Education Centre, Thodupuzha",
    "framework": "Tailwind CSS v4 + shadcn/ui (base-nova, neutral base)",
    "colorSpace": "oklch"
  },
  "primitive": {
    "color": {
      "navy": {
        "950": { "$value": "oklch(0.15 0.04 253)", "$type": "color", "$description": "Deepest navy – light foreground, dark sidebar bg" },
        "900": { "$value": "oklch(0.178 0.062 253)", "$type": "color", "$description": "Dark mode background" },
        "800": { "$value": "oklch(0.22 0.072 253)", "$type": "color", "$description": "Dark mode card / popover" },
        "700": { "$value": "oklch(0.27 0.072 253)", "$type": "color", "$description": "Dark mode secondary / muted" },
        "600": { "$value": "oklch(0.358 0.123 253)", "$type": "color", "$description": "Brand primary, sidebar bg, focus ring" },
        "500": { "$value": "oklch(0.422 0.088 253)", "$type": "color", "$description": "Muted foreground, sidebar accent" },
        "400": { "$value": "oklch(0.64 0.12 253)", "$type": "color", "$description": "Dark mode chart-1" },
        "350": { "$value": "oklch(0.64 0.06 253)", "$type": "color", "$description": "Dark mode muted foreground" },
        "300": { "$value": "oklch(0.72 0.12 253)", "$type": "color", "$description": "Dark mode primary, ring, sidebar primary" },
        "200": { "$value": "oklch(0.38 0.08 253)", "$type": "color", "$description": "Dark mode chart-4" },
        "150": { "$value": "oklch(0.52 0.1 253)", "$type": "color", "$description": "Dark mode chart-3" },
        "100": { "$value": "oklch(0.28 0.06 253)", "$type": "color", "$description": "Dark mode chart-5" },
        "50":  { "$value": "oklch(0.803 0.025 253)", "$type": "color", "$description": "Light mode chart-5" },
        "25":  { "$value": "oklch(0.891 0.015 253)", "$type": "color", "$description": "Border, input, chart-4 light" },
        "10":  { "$value": "oklch(0.944 0.008 253)", "$type": "color", "$description": "Secondary, muted bg light" }
      },
      "amber": {
        "600": { "$value": "oklch(0.55 0.2 26)", "$type": "color", "$description": "Dark mode destructive" },
        "500": { "$value": "oklch(0.577 0.25 26)", "$type": "color", "$description": "Destructive" },
        "400": { "$value": "oklch(0.56 0.22 26)", "$type": "color", "$description": "Dark mode chart-2" },
        "300": { "$value": "oklch(0.643 0.285 26)", "$type": "color", "$description": "Brand accent (CTA), chart-2 light, sidebar ring" }
      },
      "neutral": {
        "white":      { "$value": "oklch(0.996 0 0)", "$type": "color", "$description": "Pure near-white page background" },
        "white-soft": { "$value": "oklch(0.97 0 0)", "$type": "color", "$description": "Dark mode foreground / text" }
      }
    },
    "spacing": {
      "0":  { "$value": "0", "$type": "dimension" },
      "1":  { "$value": "0.25rem", "$type": "dimension" },
      "2":  { "$value": "0.5rem", "$type": "dimension" },
      "3":  { "$value": "0.75rem", "$type": "dimension" },
      "4":  { "$value": "1rem", "$type": "dimension" },
      "5":  { "$value": "1.25rem", "$type": "dimension" },
      "6":  { "$value": "1.5rem", "$type": "dimension" },
      "8":  { "$value": "2rem", "$type": "dimension" },
      "10": { "$value": "2.5rem", "$type": "dimension" },
      "12": { "$value": "3rem", "$type": "dimension" },
      "16": { "$value": "4rem", "$type": "dimension" },
      "20": { "$value": "5rem", "$type": "dimension" },
      "24": { "$value": "6rem", "$type": "dimension" }
    },
    "fontSize": {
      "xs":   { "$value": "0.875rem", "$type": "dimension" },
      "sm":   { "$value": "0.875rem", "$type": "dimension" },
      "base": { "$value": "1rem", "$type": "dimension" },
      "lg":   { "$value": "1.125rem", "$type": "dimension" },
      "xl":   { "$value": "1.25rem", "$type": "dimension" },
      "2xl":  { "$value": "1.5rem", "$type": "dimension" },
      "3xl":  { "$value": "1.875rem", "$type": "dimension" },
      "4xl":  { "$value": "2.25rem", "$type": "dimension" },
      "5xl":  { "$value": "3rem", "$type": "dimension" },
      "6xl":  { "$value": "3.75rem", "$type": "dimension" }
    },
    "fontWeight": {
      "normal":   { "$value": 400, "$type": "number" },
      "medium":   { "$value": 500, "$type": "number" },
      "semibold": { "$value": 600, "$type": "number" },
      "bold":     { "$value": 700, "$type": "number" }
    },
    "lineHeight": {
      "tight":   { "$value": 1.25, "$type": "number" },
      "snug":    { "$value": 1.375, "$type": "number" },
      "normal":  { "$value": 1.5, "$type": "number" },
      "relaxed": { "$value": 1.625, "$type": "number" },
      "loose":   { "$value": 2, "$type": "number" }
    },
    "letterSpacing": {
      "tighter": { "$value": "-0.05em", "$type": "dimension" },
      "tight":   { "$value": "-0.025em", "$type": "dimension" },
      "normal":  { "$value": "0", "$type": "dimension" },
      "wide":    { "$value": "0.025em", "$type": "dimension" }
    },
    "radius": {
      "none": { "$value": "0", "$type": "dimension" },
      "xs":   { "$value": "0.125rem", "$type": "dimension" },
      "sm":   { "$value": "0.25rem", "$type": "dimension" },
      "md":   { "$value": "0.375rem", "$type": "dimension" },
      "lg":   { "$value": "0.5rem", "$type": "dimension" },
      "xl":   { "$value": "0.625rem", "$type": "dimension" },
      "2xl":  { "$value": "0.75rem", "$type": "dimension" },
      "full": { "$value": "9999px", "$type": "dimension" }
    },
    "shadow": {
      "none": { "$value": "none", "$type": "shadow" },
      "xs":   { "$value": "0 1px 2px 0 rgb(0 0 0 / 0.05)", "$type": "shadow" },
      "sm":   { "$value": "0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1)", "$type": "shadow" },
      "md":   { "$value": "0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1)", "$type": "shadow" },
      "lg":   { "$value": "0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1)", "$type": "shadow" }
    },
    "duration": {
      "fast":   { "$value": "150ms", "$type": "duration" },
      "normal": { "$value": "200ms", "$type": "duration" },
      "slow":   { "$value": "300ms", "$type": "duration" }
    }
  },
  "semantic": {
    "light": {
      "color": {
        "background": { "$value": "{primitive.color.neutral.white}", "$type": "color", "$description": "Page background" },
        "foreground": { "$value": "{primitive.color.navy.950}", "$type": "color", "$description": "Primary text" },
        "card": { "$value": "{primitive.color.neutral.white}", "$type": "color" },
        "card-foreground": { "$value": "{primitive.color.navy.950}", "$type": "color" },
        "popover": { "$value": "{primitive.color.neutral.white}", "$type": "color" },
        "popover-foreground": { "$value": "{primitive.color.navy.950}", "$type": "color" },
        "primary": { "$value": "{primitive.color.navy.600}", "$type": "color", "$description": "Brand primary – buttons, links, focus rings" },
        "primary-foreground": { "$value": "{primitive.color.neutral.white}", "$type": "color" },
        "secondary": { "$value": "{primitive.color.navy.10}", "$type": "color", "$description": "Subtle surface for badges, secondary buttons" },
        "secondary-foreground": { "$value": "{primitive.color.navy.600}", "$type": "color" },
        "muted": { "$value": "{primitive.color.navy.10}", "$type": "color", "$description": "Muted background surface" },
        "muted-foreground": { "$value": "{primitive.color.navy.500}", "$type": "color", "$description": "De-emphasized text" },
        "accent": { "$value": "{primitive.color.amber.300}", "$type": "color", "$description": "Warm CTA accent, WhatsApp button" },
        "accent-foreground": { "$value": "{primitive.color.neutral.white}", "$type": "color" },
        "destructive": { "$value": "{primitive.color.amber.500}", "$type": "color", "$description": "Error / destructive action" },
        "destructive-foreground": { "$value": "{primitive.color.neutral.white}", "$type": "color" },
        "border": { "$value": "{primitive.color.navy.25}", "$type": "color", "$description": "Default border" },
        "input": { "$value": "{primitive.color.navy.25}", "$type": "color", "$description": "Input field border" },
        "ring": { "$value": "{primitive.color.navy.600}", "$type": "color", "$description": "Focus ring" },
        "chart-1": { "$value": "{primitive.color.navy.600}", "$type": "color" },
        "chart-2": { "$value": "{primitive.color.amber.300}", "$type": "color" },
        "chart-3": { "$value": "{primitive.color.navy.500}", "$type": "color" },
        "chart-4": { "$value": "{primitive.color.navy.25}", "$type": "color" },
        "chart-5": { "$value": "{primitive.color.navy.50}", "$type": "color" }
      },
      "sidebar": {
        "background": { "$value": "{primitive.color.navy.600}", "$type": "color" },
        "foreground": { "$value": "{primitive.color.neutral.white}", "$type": "color" },
        "primary": { "$value": "{primitive.color.neutral.white}", "$type": "color" },
        "primary-foreground": { "$value": "{primitive.color.navy.600}", "$type": "color" },
        "accent": { "$value": "{primitive.color.navy.500}", "$type": "color" },
        "accent-foreground": { "$value": "{primitive.color.neutral.white}", "$type": "color" },
        "border": { "$value": "oklch(0.422 0.088 253 / 50%)", "$type": "color", "$description": "Sidebar border with 50% opacity" },
        "ring": { "$value": "{primitive.color.amber.300}", "$type": "color" }
      }
    },
    "dark": {
      "color": {
        "background": { "$value": "{primitive.color.navy.900}", "$type": "color", "$description": "Dark mode page background" },
        "foreground": { "$value": "{primitive.color.neutral.white-soft}", "$type": "color", "$description": "Dark mode primary text" },
        "card": { "$value": "{primitive.color.navy.800}", "$type": "color" },
        "card-foreground": { "$value": "{primitive.color.neutral.white-soft}", "$type": "color" },
        "popover": { "$value": "{primitive.color.navy.800}", "$type": "color" },
        "popover-foreground": { "$value": "{primitive.color.neutral.white-soft}", "$type": "color" },
        "primary": { "$value": "{primitive.color.navy.300}", "$type": "color", "$description": "Dark mode primary – lighter navy" },
        "primary-foreground": { "$value": "{primitive.color.navy.950}", "$type": "color" },
        "secondary": { "$value": "{primitive.color.navy.700}", "$type": "color" },
        "secondary-foreground": { "$value": "{primitive.color.neutral.white-soft}", "$type": "color" },
        "muted": { "$value": "{primitive.color.navy.700}", "$type": "color" },
        "muted-foreground": { "$value": "{primitive.color.navy.350}", "$type": "color" },
        "accent": { "$value": "{primitive.color.amber.300}", "$type": "color" },
        "accent-foreground": { "$value": "{primitive.color.neutral.white}", "$type": "color" },
        "destructive": { "$value": "{primitive.color.amber.600}", "$type": "color" },
        "destructive-foreground": { "$value": "{primitive.color.neutral.white}", "$type": "color" },
        "border": { "$value": "oklch(0.97 0 0 / 12%)", "$type": "color", "$description": "Dark mode border with 12% opacity" },
        "input": { "$value": "oklch(0.97 0 0 / 16%)", "$type": "color", "$description": "Dark mode input border with 16% opacity" },
        "ring": { "$value": "{primitive.color.navy.300}", "$type": "color" },
        "chart-1": { "$value": "{primitive.color.navy.400}", "$type": "color" },
        "chart-2": { "$value": "{primitive.color.amber.400}", "$type": "color" },
        "chart-3": { "$value": "{primitive.color.navy.150}", "$type": "color" },
        "chart-4": { "$value": "{primitive.color.navy.200}", "$type": "color" },
        "chart-5": { "$value": "{primitive.color.navy.100}", "$type": "color" }
      },
      "sidebar": {
        "background": { "$value": "{primitive.color.navy.950}", "$type": "color" },
        "foreground": { "$value": "{primitive.color.neutral.white-soft}", "$type": "color" },
        "primary": { "$value": "{primitive.color.navy.300}", "$type": "color" },
        "primary-foreground": { "$value": "{primitive.color.navy.950}", "$type": "color" },
        "accent": { "$value": "{primitive.color.navy.800}", "$type": "color" },
        "accent-foreground": { "$value": "{primitive.color.neutral.white-soft}", "$type": "color" },
        "border": { "$value": "oklch(0.97 0 0 / 10%)", "$type": "color", "$description": "Dark mode sidebar border with 10% opacity" },
        "ring": { "$value": "{primitive.color.navy.300}", "$type": "color" }
      }
    }
  },
  "component": {
    "button": {
      "primary-bg":        { "$value": "{semantic.light.color.primary}", "$type": "color", "$description": "Primary button background" },
      "primary-fg":        { "$value": "{semantic.light.color.primary-foreground}", "$type": "color" },
      "secondary-bg":      { "$value": "{semantic.light.color.secondary}", "$type": "color" },
      "secondary-fg":      { "$value": "{semantic.light.color.secondary-foreground}", "$type": "color" },
      "outline-border":    { "$value": "{semantic.light.color.border}", "$type": "color" },
      "outline-fg":        { "$value": "{semantic.light.color.foreground}", "$type": "color" },
      "ghost-hover-bg":    { "$value": "{semantic.light.color.muted}", "$type": "color" },
      "destructive-bg":    { "$value": "{semantic.light.color.destructive}", "$type": "color" },
      "destructive-fg":    { "$value": "{semantic.light.color.destructive-foreground}", "$type": "color" },
      "radius":            { "$value": "{semantic.light.color.radius}", "$type": "dimension" },
      "font-size":         { "$value": "{primitive.fontSize.sm}", "$type": "dimension" },
      "font-weight":       { "$value": "{primitive.fontWeight.medium}", "$type": "number" },
      "padding-x":         { "$value": "{primitive.spacing.4}", "$type": "dimension" },
      "padding-y":         { "$value": "{primitive.spacing.2}", "$type": "dimension" },
      "gap":               { "$value": "{primitive.spacing.2}", "$type": "dimension" }
    },
    "input": {
      "bg":          { "$value": "{semantic.light.color.background}", "$type": "color" },
      "border":      { "$value": "{semantic.light.color.border}", "$type": "color" },
      "fg":          { "$value": "{semantic.light.color.foreground}", "$type": "color" },
      "placeholder": { "$value": "{semantic.light.color.muted-foreground}", "$type": "color" },
      "radius":      { "$value": "{semantic.light.color.radius}", "$type": "dimension" },
      "padding-x":   { "$value": "{primitive.spacing.3}", "$type": "dimension" },
      "padding-y":   { "$value": "{primitive.spacing.2}", "$type": "dimension" }
    },
    "card": {
      "bg":      { "$value": "{semantic.light.color.card}", "$type": "color" },
      "fg":      { "$value": "{semantic.light.color.card-foreground}", "$type": "color" },
      "border":  { "$value": "{semantic.light.color.border}", "$type": "color" },
      "radius":  { "$value": "{primitive.radius.2xl}", "$type": "dimension" },
      "padding": { "$value": "{primitive.spacing.6}", "$type": "dimension" },
      "shadow":  { "$value": "{primitive.shadow.xs}", "$type": "shadow" }
    },
    "header": {
      "height": { "$value": "{primitive.spacing.16}", "$type": "dimension" },
      "bg":     { "$value": "{semantic.light.color.background}", "$type": "color" },
      "border": { "$value": "{semantic.light.color.border}", "$type": "color" }
    },
    "section": {
      "padding-y": { "$value": "{primitive.spacing.20}", "$type": "dimension" },
      "padding-x": { "$value": "{primitive.spacing.4}", "$type": "dimension" }
    },
    "sidebar": {
      "bg":               { "$value": "{semantic.light.color.primary}", "$type": "color" },
      "fg":               { "$value": "{semantic.light.color.primary-foreground}", "$type": "color" },
      "width":            { "$value": "16rem", "$type": "dimension" },
      "collapsed-width":  { "$value": "3rem", "$type": "dimension" }
    },
    "badge": {
      "bg":          { "$value": "{semantic.light.color.secondary}", "$type": "color" },
      "fg":          { "$value": "{semantic.light.color.secondary-foreground}", "$type": "color" },
      "radius":      { "$value": "{primitive.radius.full}", "$type": "dimension" },
      "padding-x":   { "$value": "{primitive.spacing.3}", "$type": "dimension" },
      "padding-y":   { "$value": "{primitive.spacing.1}", "$type": "dimension" },
      "font-size":   { "$value": "{primitive.fontSize.sm}", "$type": "dimension" },
      "font-weight": { "$value": "{primitive.fontWeight.semibold}", "$type": "number" }
    },
    "link": {
      "fg":        { "$value": "{semantic.light.color.primary}", "$type": "color" },
      "hover-fg":  { "$value": "{primitive.color.navy.700}", "$type": "color" },
      "decoration": { "$value": "underline", "$type": "other" }
    },
    "focus": {
      "ring-color": { "$value": "{semantic.light.color.ring}", "$type": "color" },
      "ring-width": { "$value": "2px", "$type": "dimension" },
      "ring-offset": { "$value": "2px", "$type": "dimension" }
    }
  }
